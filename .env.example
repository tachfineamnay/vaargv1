# VAARG V1 — local development example configuration.
# Copy to .env and adjust. Never commit real credentials.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=1.0.0

# --- API ---
HOST=0.0.0.0
PORT=4111

# --- Web ---
APP_BASE_URL=http://localhost:3000

# --- Worker ---
WORKER_PORT=5010
WORKER_POLL_INTERVAL_MS=5000

# --- PostgreSQL 18 (local Docker) ---
DATABASE_URL=postgres://vaarg:vaarg_local_password@127.0.0.1:5432/vaarg?sslmode=disable
DATABASE_READINESS_TIMEOUT_MS=1500

# --- Valkey (local Docker) ---
VALKEY_URL=redis://127.0.0.1:6379
VALKEY_KEY_PREFIX=vaarg:
VALKEY_READINESS_TIMEOUT_MS=1000

# --- Hatchet (future durable orchestration; disabled by default) ---
HATCHET_ENABLED=false
HATCHET_URL=
HATCHET_TOKEN=

# --- Shopify (not required for P00) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_TOKEN=

# --- AI providers (not required for P00; no implicit fallback) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
