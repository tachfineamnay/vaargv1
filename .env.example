# Placeholders only. Use an uncommitted .env or Coolify secret store.
# Supply separately generated strong credentials; URL-encode special characters
# in database URL usernames/passwords. postgres is the Compose service DNS name.
POSTGRES_USER=<maintenance-user>
POSTGRES_PASSWORD=<maintenance-password>
POSTGRES_DB=<database-name>
MAINTENANCE_DATABASE_URL=postgresql://<maintenance-user>:<url-encoded-maintenance-password>@postgres:5432/<database-name>
DATABASE_URL=postgresql://<restricted-runtime-user>:<url-encoded-runtime-password>@postgres:5432/<database-name>
APP_VERSION=<git-commit-sha>
LOG_LEVEL=info
# Only after reviewing cluster-wide impact of existing vaarg_app role:
MIGRATION_ALLOW_CLUSTER_ROLE_CHANGE=false
# Optional storefront configuration; use SHOPIFY_STOREFRONT_TOKEN as tokenEnv.
STOREFRONT_BINDINGS_JSON=[]
SHOPIFY_STOREFRONT_TOKEN=
CATALOG_JOB_SIGNING_SECRET=
