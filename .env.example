# VAARG V1 — local development example configuration.
# Copy to .env and adjust. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=1.0.0

# --- Infrastructure (docker compose dev) ---
POSTGRES_USER=vaarg
POSTGRES_PASSWORD=vaarg_local_password
POSTGRES_DB=vaarg

# --- API ---
HOST=0.0.0.0
PORT=4111
DATABASE_URL=postgres://vaarg:vaarg_local_password@127.0.0.1:5432/vaarg?sslmode=disable
DATABASE_READINESS_TIMEOUT_MS=1500
VALKEY_URL=redis://127.0.0.1:6379
VALKEY_KEY_PREFIX=vaarg:
VALKEY_READINESS_TIMEOUT_MS=1000

# --- Web ---
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:4111

# --- Worker ---
WORKER_PORT=5010
WORKER_POLL_INTERVAL_MS=5000
WORKER_REQUIRE_READY=true

# --- Hatchet (approved durable orchestrator; disabled by default) ---
HATCHET_ENABLED=false
HATCHET_URL=
HATCHET_TOKEN=

# --- Shopify (not required for P00) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_TOKEN=

# --- AI providers (not required for P00; no implicit fallback) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Server-only JSON hostname bindings; tokenEnv names a separately injected secret.
# STOREFRONT_BINDINGS_JSON=[]
# CATALOG_HOST=store.example
# SHOPIFY_STOREFRONT_TOKEN= (set only in the secret store)

# Example syntax only: configure verified storefront hosts in deployment secrets.
# STOREFRONT_BINDINGS_JSON=[{"host":"store.example","storeId":"00000000-0000-4000-8000-000000000001","country":"FR","language":"FR","currency":"EUR","shopifyDomain":"example.myshopify.com","tokenEnv":"SHOPIFY_STORE_TOKEN","metafields":[]}]
# SHOPIFY_STORE_TOKEN=
# CATALOG_JOB_SIGNING_SECRET=
