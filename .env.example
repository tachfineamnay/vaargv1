# Placeholders only. Use an uncommitted .env or Coolify secret store.
# Supply separately generated strong credentials; URL-encode special characters
# in database URL usernames/passwords. postgres is the Compose service DNS name.
POSTGRES_USER=<maintenance-user>
POSTGRES_PASSWORD=<maintenance-password>
POSTGRES_DB=<database-name>
MAINTENANCE_DATABASE_URL=postgresql://<maintenance-user>:<url-encoded-maintenance-password>@postgres:5432/<database-name>
DATABASE_URL=postgresql://<restricted-runtime-user>:<url-encoded-runtime-password>@postgres:5432/<database-name>
APP_VERSION=<git-commit-sha>
LOG_LEVEL=info
# Only after reviewing cluster-wide impact of existing vaarg_app role:
MIGRATION_ALLOW_CLUSTER_ROLE_CHANGE=false
# Optional storefront configuration; use SHOPIFY_STOREFRONT_TOKEN as tokenEnv.
STOREFRONT_BINDINGS_JSON=[]
SHOPIFY_STOREFRONT_TOKEN=
CATALOG_JOB_SIGNING_SECRET=
# Explicit trusted proxy boundary: only enable behind a proxy you control.
# Forwarded headers are ignored otherwise; tenant Host is always direct.
TRUST_PROXY=false

# FL06 — Confined Hermes runtime (NousResearch/hermes-agent v0.23.4, private server-only)
HERMES_ENABLED=false
HERMES_BASE_URL=http://hermes:8642
HERMES_API_SERVER_KEY=
HERMES_TOOL_BRIDGE_SECRET=
HERMES_REQUEST_TIMEOUT_MS=60000
HERMES_STREAM_IDLE_TIMEOUT_MS=30000
VAARG_INTERNAL_API_URL=http://api:4111

# FL06 — Explicit direct-only LLM provider policy (Gemini API & DeepSeek API; no proxies/routers/fallbacks)
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
VAARG_MASTER_MODEL_ID=gemini-2.5-flash
VAARG_SPECIALIST_MODEL_ID=gemini-2.5-flash
VAARG_RUN_MAX_TOTAL_TOKENS=48000
VAARG_RUN_MAX_INPUT_TOKENS=36000
VAARG_RUN_MAX_OUTPUT_TOKENS=12000
VAARG_RUN_MAX_COST_USD_MICROS=250000
VAARG_RUN_MAX_MODEL_CALLS=12
VAARG_RUN_MAX_TOOL_CALLS=20
VAARG_RUN_MAX_CONCURRENT_CHILDREN=3
VAARG_RUN_TIMEOUT_MS=60000

# FL06 — Hatchet durable workflow orchestration (@hatchet-dev/typescript-sdk 1.49.1)
HATCHET_ENABLED=false
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=
HATCHET_CLIENT_API_URL=
HATCHET_CLIENT_NAMESPACE=vaarg
HATCHET_CLIENT_TLS_STRATEGY=tls
HATCHET_WORKER_NAME=vaarg-worker
HATCHET_WORKER_SLOTS=10

