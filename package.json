{
  "name": "vaargv1",
  "version": "1.0.0",
  "private": true,
  "description": "VAARG V1 \u2014 industrial adaptive Shopify headless storefront",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "clean": "turbo run clean --continue",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml,css}\"",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "smoke": "node scripts/certification/smoke.mjs",
    "certify": "bash scripts/certification/certify.sh",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:down": "docker compose -f docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.4",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
