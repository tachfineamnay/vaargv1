{
  "name": "@vaarg/persistence",
  "version": "1.0.0",
  "private": true,
  "description": "VAARG V1 Drizzle persistence: schema, migrations, RLS-aware client",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/migrate.js",
    "migrate:generate": "drizzle-kit generate",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "catalog:step": "node dist/commerce/cli.js"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@vaarg/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "optionalDependencies": {
    "ioredis": "5.9.2"
  }
}
