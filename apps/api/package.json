{
  "name": "@vaarg/api",
  "version": "1.0.0",
  "private": true,
  "description": "VAARG V1 NestJS/Fastify HTTP API",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-fastify": "12.6.2",
    "@vaarg/shared": "workspace:*",
    "ioredis": "6.1.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.2",
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
