{
  "name": "@vaargv1/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "tsx src/db/studio.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-fastify": "12.6.2",
    "@nestjs/platform-socket.io": "12.6.2",
    "@nestjs/swagger": "11.0.0",
    "@nestjs/terminus": "12.0.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "@vaargv1/contracts": "workspace:*",
    "ioredis": "6.1.0",
    "pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "pgvector": "0.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/compress": "9.3.0",
    "@nestjs/config": "4.0.0",
    "joi": "17.13.3",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "typescript": "5.9.2",
    "eslint": "10.15.0",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "vitest": "5.1.2",
    "@vitest/ui": "5.1.2",
    "tsx": "4.23.15",
    "@types/joi": "17.2.3"
  }
}