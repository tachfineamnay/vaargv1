{
  "name": "@vaarg/web",
  "version": "1.0.0",
  "private": true,
  "description": "VAARG V1 Next.js storefront web entrypoint",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@vaarg/shared": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "typescript-eslint": "8.74.0"
  }
}
