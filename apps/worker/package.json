{
  "name": "@vaarg/worker",
  "version": "1.0.0",
  "private": true,
  "description": "VAARG V1 durable worker entrypoint (Hatchet-ready)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@vaarg/shared": "workspace:*",
    "ioredis": "6.1.0",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
